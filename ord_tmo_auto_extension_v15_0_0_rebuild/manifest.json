{
  "manifest_version": 3,
  "name": "원랜디 2.310 악몽 실전 판단 코치 v25.0.1",
  "version": "25.0.1",
  "description": "현재 패의 정확한 순차 원장과 생존 마감으로 다음 한 행동만 결정하는 원랜디 2.310 악몽 코치입니다.",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "https://tmo.gg/build-helper/*",
    "https://tmo.gg/*/build-helper/*",
    "https://www.tmo.gg/build-helper/*",
    "https://www.tmo.gg/*/build-helper/*",
    "http://127.0.0.1:25625/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ORD 악몽 실전 판단 코치 v25.0.1"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://tmo.gg/build-helper/*",
        "https://tmo.gg/*/build-helper/*",
        "https://www.tmo.gg/build-helper/*",
        "https://www.tmo.gg/*/build-helper/*"
      ],
      "js": [
        "content-tmo.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://tmo.gg/build-helper/*",
        "https://tmo.gg/*/build-helper/*",
        "https://www.tmo.gg/build-helper/*",
        "https://www.tmo.gg/*/build-helper/*"
      ],
      "js": [
        "ord_page_unthrottle.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://tmo.gg/build-helper/*",
        "https://tmo.gg/*/build-helper/*",
        "https://www.tmo.gg/build-helper/*",
        "https://www.tmo.gg/*/build-helper/*"
      ],
      "js": [
        "ord_page_nettap.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
